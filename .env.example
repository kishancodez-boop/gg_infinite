# ============================================
# GreenGrid India — Root Environment Reference
# ============================================
# Copy server/.env.example to server/.env and client/.env.example to client/.env
# Never commit real .env files or database credentials to Git.

# --------------------------------------------
# Backend (server/.env or Render Environment)
# --------------------------------------------
# Development: development | Production: production
NODE_ENV=development
PORT=5000

# Comma-separated allowed frontend origins (never use * in production)
# Development: http://localhost:5173
# Production (Vercel): https://your-greengrid-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# Leave empty if MongoDB is not configured yet (API reports status: "degraded" / "unconfigured").
# Local example: mongodb://127.0.0.1:27017/greengrid_india
# Atlas example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/greengrid_india?retryWrites=true&w=majority
MONGODB_URI=

# Server-only secret for privileged write/delete/REA admin endpoints (NEVER expose to frontend)
ADMIN_API_KEY=

# --------------------------------------------
# Frontend (client/.env or Vercel Environment)
# --------------------------------------------
# Leave empty in local Vite dev to use the built-in /api proxy to http://localhost:5000.
# Production (Render backend URL): https://your-greengrid-api.onrender.com
VITE_API_BASE_URL=
