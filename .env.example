# ============================================
# GreenGrid India — Root Environment Reference
# ============================================
# Copy server/.env.example to server/.env and client/.env.example to client/.env
# Never commit real .env files or database credentials to Git.

# Backend (server/.env)
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173
# Optional for Milestone 01. Leave empty if MongoDB is not configured yet.
# Example local URI: mongodb://127.0.0.1:27017/greengrid_india
# Example Atlas URI: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/greengrid_india?retryWrites=true&w=majority
MONGODB_URI=

# Frontend (client/.env)
# Leave empty in local Vite dev to use the built-in /api proxy to http://localhost:5000
VITE_API_BASE_URL=

