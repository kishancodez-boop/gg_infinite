# Backend Server Environment Variables
# Copy this file to server/.env and update values as needed.
# Never commit .env files or real database credentials to Git.

NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Leave blank until MongoDB is ready. The API starts cleanly without it
# and accurately reports database status as "unconfigured".
# Local example: mongodb://127.0.0.1:27017/greengrid_india
# Atlas example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/greengrid_india?retryWrites=true&w=majority
MONGODB_URI=

